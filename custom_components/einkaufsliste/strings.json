{
  "config": {
    "step": {
      "user": {
        "title": "Set up shopping list",
        "description": "Almost done! Set the cleanup day and time later right in the card: ⚙️ → Cleanup.",
        "data": {
          "sidebar": "📌 Show in sidebar"
        },
        "data_description": {
          "sidebar": "Adds a \"Einkaufsliste\" entry to the sidebar (full-page view). Off by default."
        }
      }
    },
    "abort": {
      "single_instance_allowed": "Already configured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Shopping list – options",
        "description": "Cleanup (on/off, day, time) is now set right in the card: ⚙️ → Cleanup.",
        "data": {
          "reset_pin": "🔒 PIN für die Einstellungen zurücksetzen",
          "sidebar": "📌 Show in sidebar"
        },
        "data_description": {
          "reset_pin": "Anhaken, wenn die PIN für das Zahnrad in der Karte vergessen wurde. Danach ist das Zahnrad wieder ohne PIN offen.",
          "sidebar": "Adds a \"Einkaufsliste\" entry to the sidebar (full-page view). Off by default."
        }
      }
    }
  },
  "services": {
    "add_item": {
      "name": "Add item",
      "description": "Adds an item. If it is on the list and checked, it gets unchecked.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "What to buy."
        },
        "store": {
          "name": "Store",
          "description": "Store name."
        },
        "category": {
          "name": "Category",
          "description": "Category name."
        },
        "quantity": {
          "name": "Quantity",
          "description": "e.g. 2 litres"
        },
        "note": {
          "name": "Note",
          "description": "e.g. organic"
        },
        "for_whom": {
          "name": "For whom",
          "description": "Who is it for?"
        },
        "added_by": {
          "name": "Added by",
          "description": "Empty = the calling user."
        }
      }
    },
    "check_item": {
      "name": "Check item",
      "description": "Checks an item.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Which item?"
        },
        "store": {
          "name": "Store",
          "description": "Optional."
        }
      }
    },
    "remove_item": {
      "name": "Remove item",
      "description": "Removes an item completely.",
      "fields": {
        "name": {
          "name": "Name",
          "description": "Which item?"
        },
        "store": {
          "name": "Store",
          "description": "Optional."
        }
      }
    },
    "add_recipe": {
      "name": "Add recipe",
      "description": "Puts all ingredients of a recipe on the list.",
      "fields": {
        "name": {
          "name": "Recipe",
          "description": "Recipe name."
        },
        "added_by": {
          "name": "Added by",
          "description": "Empty = the calling user."
        }
      }
    },
    "cleanup": {
      "name": "Cleanup",
      "description": "Checks all open items that are old enough. Nothing is deleted.",
      "fields": {
        "force": {
          "name": "Check everything",
          "description": "On = check all open items."
        },
        "min_age_days": {
          "name": "Minimum age (days)",
          "description": "Override once."
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "zuletzt_eingetragen": {
        "name": "Zuletzt eingetragen"
      },
      "gesundheit": {
        "name": "Gesundheit",
        "state": {
          "ok": "Alles in Ordnung",
          "hinweis": "Hinweis",
          "problem": "Problem",
          "unbekannt": "Unbekannt"
        }
      }
    },
    "binary_sensor": {
      "etwas_zu_kaufen": {
        "name": "Etwas zu kaufen"
      }
    }
  }
}
